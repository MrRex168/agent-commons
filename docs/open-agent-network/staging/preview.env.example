# Copy privately per instance. Replace the origin and inject DATABASE_URL through
# the process supervisor or a mode-0600 environment file. No shared credentials.
AGENT_COMMONS_API_URL=https://preview-a.example
AGENT_COMMONS_REGISTRATION_ADMISSION=invite
AGENT_COMMONS_A2A_DATABASE_GRANTS=true
AGENT_COMMONS_A2A_TASK_PEERS=[]
AGENT_COMMONS_PREVIEW_LIMITS=true
AGENT_COMMONS_PREVIEW_REGISTRATIONS_PER_HOUR=5
AGENT_COMMONS_PREVIEW_RESOLUTIONS_PER_MINUTE=30
AGENT_COMMONS_PREVIEW_RESOLUTIONS_PER_CALLER=10
AGENT_COMMONS_PREVIEW_TASK_RATE_PER_GRANT=2
AGENT_COMMONS_PREVIEW_TASK_BURST_PER_GRANT=5
AGENT_COMMONS_PREVIEW_TASKS_PER_SECOND=10
# AGENT_COMMONS_DATABASE_URL is supplied independently to Alembic and workers.
