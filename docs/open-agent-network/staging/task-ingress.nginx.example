# HTTP context. Illustrative A2A path on one ingress. See runbook for the
# outer source ACL and WAF, other routes, and shared multi-proxy policy.
map $http_authorization $preview_peer_shape {
    default 0;
    "~^Bearer a2a_[A-Za-z0-9_-]{43}$" 1;
}
map $http_content_type $preview_json {
    default 0;
    application/json 1;
}
limit_req_zone $binary_remote_addr zone=preview_task_source:1m rate=10r/s;
limit_req_zone $server_name zone=preview_task_total:1m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=preview_task_connections:1m;

# Add inside a TLS server with a fixed server_name and a separate default
# vhost rejecting unknown hosts. Replace preview-a.example per instance.
location = /a2a {
    if ($request_method != POST) { return 405; }
    if ($preview_peer_shape = 0) { return 401; }
    if ($preview_json = 0) { return 415; }
    if ($http_content_encoding != "") { return 415; }
    if ($args != "") { return 400; }
    limit_req zone=preview_task_source burst=5 nodelay;
    limit_req zone=preview_task_total burst=5 nodelay;
    limit_req_status 429;
    limit_conn preview_task_connections 8;
    limit_conn_status 429;
    client_max_body_size 16k;
    client_body_timeout 3s;
    proxy_request_buffering on;
    proxy_connect_timeout 2s;
    proxy_send_timeout 5s;
    proxy_read_timeout 5s;
    proxy_set_header Host preview-a.example;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_pass http://127.0.0.1:8000;
    access_log off;
}
